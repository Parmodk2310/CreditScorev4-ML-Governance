# CreditScoreV4 ML Governance - Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/creditscorev4
REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://creditscorev4-artifacts
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Airflow
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:password@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=creditscorev4-artifacts

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your-grafana-api-key

# Alerting
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Model Registry
MODEL_REGISTRY_URI=http://localhost:5000
MODEL_NAME=creditscorev4
MODEL_STAGE=production

# Feature Store
FEATURE_STORE_URL=redis://localhost:6379/1

# Incident Response
SEV1_ESCALATION_MINUTES=15
SEV2_ESCALATION_MINUTES=60
AUTO_ROLLBACK_THRESHOLD_AUC=0.76
AUTO_ROLLBACK_THRESHOLD_FAIRNESS=0.80

# Data Sources
UPSTREAM_VENDOR_API_URL=https://api.vendor.com/v2
UPSTREAM_VENDOR_API_KEY=your-vendor-api-key
DATA_LAKE_PATH=s3://creditscorev4-data-lake
