# CreditScoreV4 ML Governance
# Current environment contract for the gated AWS deployment path.
#
# Local verification is fail-closed by default and does not require AWS access.

AWS_DEPLOY_ENABLED=false
AWS_REGION=ap-south-1

# Required only when AWS_DEPLOY_ENABLED=true.
AWS_ROLE_TO_ASSUME=
TF_STATE_BUCKET=
TF_STATE_KEY=creditscorev4/production.tfstate
ACM_CERTIFICATE_ARN=

# Used only when an explicit deployment confirmation is required.
# CONFIRM_DEPLOY=DEPLOY

# Required only for the local Grafana observability stack.
GRAFANA_ADMIN_PASSWORD=
