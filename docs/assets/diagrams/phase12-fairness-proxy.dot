digraph Phase12 {
  graph [rankdir=LR, labelloc="t", label="Phase 12 — Intersectional Fairness & Proxy-Risk Evidence", fontsize=20];
  node [shape=box, style="rounded", fontsize=11];
  vendor [label="Vendor E\nnon-protected feature stress\nfor female|group_c"];
  quality [label="Data quality\nPASS"];
  drift [label="Aggregate drift\nSTABLE"];
  fairness [label="Fairness evaluator\nsex • demographic group\nintersection"];
  intersection [label="female|group_c\nFAIL"];
  assoc [label="Association screening\nη² / Cramér's V"];
  shap [label="SHAP mean |attribution|"];
  proxy [label="Proxy-risk review priority\ndevice_risk_score\ncredit_utilization\nbank_transaction_risk"];
  evidence [label="Expanded fairness + proxy\n+ SHAP evidence"];
  boundary [label="Protected attributes excluded\nfrom model + SHAP features"];
  vendor -> quality -> drift -> fairness -> intersection -> evidence;
  vendor -> assoc -> proxy;
  shap -> proxy -> evidence;
  boundary -> fairness [style=dashed];
}
