    SG --> CA["CANARY<br/>10% to 25% to 50% to 100%"]
    CA --> CG{"Canary gates pass?"}
    CG --> RB2["Rollback to STAGING"]
    CG --> PR["PRODUCTION"]

    P --> A["Decision artifact<br/>SHA-256 evidence hashes<br/>audit record"]
    PR --> A
    RB1 --> A
    RB2 --> A
    R --> A

    X["Illegal transition blocked<br/>CANDIDATE directly to PRODUCTION"] -.-> C
