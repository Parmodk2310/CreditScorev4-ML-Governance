flowchart TB
    E["Verified evidence<br/>quality, performance, calibration,<br/>drift, fairness, integrity"] --> P["Governance policy"]
    P --> D{"Promotion decision"}

    D --> R["REJECTED<br/>blocking reason persisted"]
    D --> C["CANDIDATE approved<br/>for staged release"]

    C --> ST["STAGING"]
