digraph G {
  rankdir=LR;
  graph [fontsize=10, labelloc=t, label="Phase 5 - Governance Registry and Promotion Decisions"];
  node [shape=box, style="rounded,filled", fillcolor="#eff9ff", color="#2f8ab8"];
  edge [color="#2f8ab8"];
  A [label="Candidate model
package"];
  B [label="Aggregate governance
gates"];
  C [label="Quality, drift, fairness,
explainability evidence"];
  D [label="Approve candidate?", shape=diamond, fillcolor="#fff7d6", color="#aa8a2e"];
  E [label="Promote to
STAGING registry state"];
  F [label="Reject candidate
and persist decision"];
  G [label="Write release
and audit artifacts"];
  A -> B -> C -> D;
  D -> E [label="Yes"];
  D -> F [label="No"];
  E -> G;
  F -> G;
}
