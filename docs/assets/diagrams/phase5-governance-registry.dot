digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.3, nodesep=0.48, ranksep=0.85, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f9fc", color="#64748b", fontname="DejaVu Sans", fontsize=11];
  edge [color="#475569", penwidth=1.4, arrowsize=0.8];
  e [label="Evidence bundle\nquality / drift / performance\ncalibration / fairness"];
  h [label="SHA-256\nintegrity verification"];
  p [label="Versioned policy\nblocking gates"];
  dec [label="Deterministic decision"];
  app [label="APPROVE", fillcolor="#ecfdf5", color="#047857"];
  rej [label="REJECT", fillcolor="#fff1f2", color="#be123c"];
  st [label="Registry\nCANDIDATE -> STAGING"];
  rr [label="Registry\nREJECTED"];
  audit [label="Audit record\n+ decision artifact"];
  e -> h -> p -> dec;
  dec -> app;
  dec -> rej;
  app -> st -> audit;
  rej -> rr -> audit;
}
