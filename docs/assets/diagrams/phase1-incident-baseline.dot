digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad=0.3, nodesep=0.55, ranksep=0.8, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f9fc", color="#64748b", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
  edge [color="#475569", penwidth=1.4, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10];
  a [label="Vendor A\nhealthy synthetic data"];
  b [label="Train baseline\nCreditScoreV4"];
  c [label="Healthy evidence\nAUC 0.8025\nNULL 3.14%"];
  d [label="Vendor B incident fixture\nNULL stress"];
  e [label="Incident evidence\nAUC 0.7329\nNULL 22.00%", fillcolor="#fff1f2", color="#be123c"];
  f [label="Acceptance gates\nPHASE 1 VERIFIED", fillcolor="#ecfdf5", color="#047857"];
  a -> b -> c;
  c -> d [label="controlled incident"];
  d -> e -> f;
}
