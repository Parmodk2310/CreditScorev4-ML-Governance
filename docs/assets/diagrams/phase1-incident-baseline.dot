digraph G {
  rankdir=LR;
  graph [fontsize=10, labelloc=t, label="Phase 1 - Incident Baseline and Reproduction"];
  node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#4a78c2"];
  edge [color="#4a78c2"];
  A [label="Vendor A
train + holdout"];
  B [label="Train baseline
credit model"];
  C [label="Healthy metrics
ROC-AUC + null rate"];
  D [label="Vendor B
incident fixture"];
  E [label="Replay incident
on baseline model"];
  F [label="Compare healthy
vs incident"];
  G [label="Phase 1 evidence
written"];
  A -> B -> C -> D -> E -> F -> G;
}
