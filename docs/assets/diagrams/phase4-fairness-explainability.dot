digraph G {
  rankdir=LR;
  graph [fontsize=10, labelloc=t, label="Phase 4 - Fairness and Explainability"];
  node [shape=box, style="rounded,filled", fillcolor="#fff1f1", color="#c25a5a"];
  edge [color="#c25a5a"];
  A [label="Vendor D
candidate"];
  B [label="Protected-group
fairness evaluation"];
  C [label="DP ratio + EO/EOdds
checks"];
  D [label="SHAP explainability
review"];
  E [label="Proxy feature
investigation"];
  F [label="Fairness passes?", shape=diamond, fillcolor="#fff7d6", color="#aa8a2e"];
  G [label="Allow governance
progression"];
  H [label="Fail fairness
governance"];
  I [label="Write fairness
and SHAP evidence"];
  A -> B -> C -> D -> E -> F;
  F -> G [label="Yes"];
  F -> H [label="No"];
  H -> I;
}
