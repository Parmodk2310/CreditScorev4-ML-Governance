digraph G {
  rankdir=LR;
  graph [fontsize=10, labelloc=t, label="Phase 7 - Automation and Deployment Controls"];
  node [shape=box, style="rounded,filled", fillcolor="#fff7ec", color="#c27b2a"];
  edge [color="#c27b2a"];
  A [label="GitHub Actions
quality + security"];
  B [label="Container build
and scan"];
  C [label="Deploy preflight
checks"];
  D [label="Terraform + AWS
ECS/Fargate architecture"];
  E [label="AWS_DEPLOY_ENABLED?", shape=diamond, fillcolor="#fff7d6", color="#aa8a2e"];
  F [label="Controlled
deployment path"];
  G [label="Fail-closed
safe default"];
  H [label="Release manifest
and evidence"];
  A -> B -> C -> D -> E;
  E -> F [label="Yes"];
  E -> G [label="No"];
  F -> H;
  G -> H;
}
