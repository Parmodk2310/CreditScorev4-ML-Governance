digraph G {
  rankdir=LR;
  graph [fontsize=10, labelloc=t, label="Phase 11 - Scheduled Monitoring Orchestration"];
  node [shape=box, style="rounded,filled", fillcolor="#eef7ff", color="#4279c9"];
  edge [color="#4279c9"];
  A [label="Scheduled monitoring
workflow"];
  B [label="Run fail-closed
governance cycle"];
  C [label="Execute Phase 1-10
tasks in order"];
  D [label="Persist monitoring
manifest + events"];
  E [label="All tasks pass?", shape=diamond, fillcolor="#fff7d6", color="#aa8a2e"];
  F [label="Final monitoring
status PASS"];
  G [label="Final monitoring
status FAIL"];
  H [label="Auto retraining +
promotion disabled"];
  A -> B -> C -> D -> E;
  E -> F [label="Yes"];
  E -> G [label="No"];
  F -> H;
  G -> H;
}
