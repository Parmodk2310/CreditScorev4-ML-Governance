digraph Phase9 {
  graph [rankdir=LR, labelloc="t", label="Phase 9 — Business Impact & Incident Outcome Evidence", fontsize=20];
  node [shape=box, style="rounded", fontsize=11];
  population [label="Same 15,000 applicants\nSame default_30d labels"];
  healthy [label="Vendor A\nhealthy inputs"];
  incident [label="Vendor B\nincident inputs"];
  model [label="Same persisted model\nthreshold = 0.50"];
  compare [label="Decision comparison"];
  metrics [label="Approval rate\nApproved default rate\nRisk delta\nDecision flips"];
  evidence [label="business_impact.json\ncohort_summary.csv\ndecision_transition_summary.json"];
  verify [label="Phase 9 verifier"];
  population -> healthy;
  population -> incident;
  healthy -> model;
  incident -> model;
  model -> compare -> metrics -> evidence -> verify;
}
