{
  "title": "CreditScoreV4 Phase 6 Serving",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "targets": [{"expr": "sum(rate(creditscore_http_requests_total[1m])) by (route)", "legendFormat": "{{route}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "P95 Request Latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(creditscore_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Model Ready",
      "targets": [{"expr": "creditscore_model_ready"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8}
    },
    {
      "type": "stat",
      "title": "Canary Share",
      "targets": [{"expr": "creditscore_canary_share"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Risk Probability",
      "targets": [{"expr": "histogram_quantile(0.50, sum(rate(creditscore_risk_probability_bucket[5m])) by (le))", "legendFormat": "p50"}],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 8}
    }
  ]
}
